# ===================================
# Istanbul Plus E-commerce Environment Configuration
# ===================================
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to version control

# ===================================
# Django Core Settings
# ===================================
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_very_secure_secret_key_here_minimum_50_characters_change_this

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=istanbulplus.ir,www.istanbulplus.ir,localhost,127.0.0.1

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
DB_NAME=istanbulplus_db
DB_USER=istanbulplus_user
DB_PASSWORD=your_secure_database_password_here_change_this
DB_HOST=istanbulplus-db
DB_PORT=5432

# ===================================
# Redis Configuration
# ===================================
# Redis for caching (database 3)
REDIS_URL=redis://redis:6379/3

# Redis for rate limiting (database 4)
REDIS_RATE_LIMIT_URL=redis://redis:6379/4

# ===================================
# Celery Configuration
# ===================================
# Redis for Celery broker (database 5)
CELERY_BROKER_URL=redis://redis:6379/5

# Redis for Celery results (database 6)
CELERY_RESULT_BACKEND=redis://redis:6379/6

# ===================================
# Email Configuration (SMTP)
# ===================================
# For Gmail, use app-specific password: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@istanbulplus.ir
EMAIL_HOST_PASSWORD=your_email_app_password_here_change_this
DEFAULT_FROM_EMAIL=noreply@istanbulplus.ir

# ===================================
# Site Configuration
# ===================================
SITE_URL=https://istanbulplus.ir

# ===================================
# SMS Configuration (Kavenegar)
# ===================================
# Get API key from: https://panel.kavenegar.com/client/setting/account
OTP_SMS_BACKEND=kavenegar
OTP_SMS_API_KEY=your_kavenegar_api_key_here_change_this

# ===================================
# Payment Gateway Configuration
# ===================================
# Your payment gateway merchant ID
PAYMENT_MERCHANT_ID=your_merchant_id_here_change_this

# ===================================
# Security Configuration
# ===================================
# Email for security reports
SECURITY_REPORT_EMAIL=admin@istanbulplus.ir

# ===================================
# Monitoring Configuration (Optional)
# ===================================
# Grafana admin password
GRAFANA_PASSWORD=your_grafana_admin_password_here_change_this

# Sentry DSN for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here_optional

# ===================================
# Logging Configuration
# ===================================
LOG_LEVEL=INFO

# ===================================
# Performance Configuration
# ===================================
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Session cookie age in seconds (default: 24 hours)
SESSION_COOKIE_AGE=86400

# ===================================
# File Upload Configuration
# ===================================
# Maximum upload size in bytes (default: 5MB)
MAX_UPLOAD_SIZE=5242880

# Comma-separated list of allowed file types
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ===================================
# Rate Limiting Configuration
# ===================================
RATE_LIMIT_ENABLED=True
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=10
OTP_RATE_LIMIT=5

# ===================================
# Docker Environment Variables
# ===================================
# These are used by docker-compose.yml
ISTANBULPLUS_DB_PASSWORD=your_secure_database_password_here_change_this
ISTANBULPLUS_SECRET_KEY=your_very_secure_secret_key_here_minimum_50_characters_change_this

# ===================================
# SSL Certificate Paths (Production)
# ===================================
# Paths inside nginx container
SSL_CERT_PATH=/etc/nginx/ssl/istanbulplus.ir.crt
SSL_KEY_PATH=/etc/nginx/ssl/istanbulplus.ir.key

# ===================================
# Backup Configuration (Optional)
# ===================================
# AWS S3 for backups (optional)
BACKUP_S3_BUCKET=istanbulplus-backups
BACKUP_S3_ACCESS_KEY=your_s3_access_key_optional
BACKUP_S3_SECRET_KEY=your_s3_secret_key_optional
BACKUP_S3_REGION=us-east-1

# ===================================
# Notes
# ===================================
# 1. Replace all "change_this" values with actual secure values
# 2. Use strong passwords (minimum 16 characters, mix of letters, numbers, symbols)
# 3. Never commit .env file to version control
# 4. Keep backups of .env file in a secure location
# 5. Rotate secrets regularly (every 90 days recommended)
