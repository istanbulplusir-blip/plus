{
  "dashboard": {
    "id": null,
    "title": "Database Performance",
    "tags": ["database", "postgresql", "performance"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Database Size",
        "type": "stat",
        "targets": [
          {
            "expr": "django_db_size_bytes{job=\"istanbulplus\"}",
            "legendFormat": "Database Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Active Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "django_db_connections_active{job=\"istanbulplus\"}",
            "legendFormat": "Active Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Query Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(django_db_query_duration_seconds_bucket{job=\"istanbulplus\"}[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(django_db_query_duration_seconds_bucket{job=\"istanbulplus\"}[5m]))",
            "legendFormat": "50th percentile"
          }
        ],
        "yAxes": [
          {
            "label": "Query Duration (seconds)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Slow Queries",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(django_db_slow_queries_total{job=\"istanbulplus\"}[5m])",
            "legendFormat": "Slow Queries"
          }
        ],
        "yAxes": [
          {
            "label": "Queries per second",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Table Sizes",
        "type": "table",
        "targets": [
          {
            "expr": "django_table_size_bytes{job=\"istanbulplus\"}",
            "legendFormat": "{{table}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "Index Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "django_index_usage_ratio{job=\"istanbulplus\"}",
            "legendFormat": "{{index}}"
          }
        ],
        "yAxes": [
          {
            "label": "Usage Ratio",
            "min": 0,
            "max": 1
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
