# Istanbul Plus E-commerce Environment Configuration
# Copy this file to .env and fill in the actual values

# Django Settings
SECRET_KEY=your_very_secure_secret_key_here_minimum_50_characters
DEBUG=False
ALLOWED_HOSTS=istanbulplus.ir,www.istanbulplus.ir,localhost,127.0.0.1

# Database Configuration
DB_NAME=istanbulplus_db
DB_USER=istanbulplus_user
DB_PASSWORD=your_secure_database_password_here
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_RATE_LIMIT_URL=redis://127.0.0.1:6379/4

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@istanbulplus.ir
EMAIL_HOST_PASSWORD=your_email_app_password_here
DEFAULT_FROM_EMAIL=noreply@istanbulplus.ir

# Site Configuration
SITE_URL=https://istanbulplus.ir

# SMS Configuration (Kavenegar)
OTP_SMS_BACKEND=kavenegar
OTP_SMS_API_KEY=your_kavenegar_api_key_here

# Payment Gateway Configuration
PAYMENT_MERCHANT_ID=your_merchant_id_here

# Security Configuration
SECURITY_REPORT_EMAIL=admin@istanbulplus.ir

# Peykan Tourism Database (for reference)
PEYKAN_DB_PASSWORD=your_peykan_database_password_here

# Monitoring Configuration
GRAFANA_PASSWORD=your_grafana_admin_password_here

# SSL Certificate Paths (for production)
SSL_CERT_PATH=/etc/nginx/ssl/istanbulplus.ir.crt
SSL_KEY_PATH=/etc/nginx/ssl/istanbulplus.ir.key

# Backup Configuration
BACKUP_S3_BUCKET=istanbulplus-backups
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_S3_REGION=us-east-1

# Logging Configuration
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# Performance Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/5
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/6

# Cache Configuration
CACHE_TTL=3600
SESSION_COOKIE_AGE=86400

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=True
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=10
OTP_RATE_LIMIT=5
